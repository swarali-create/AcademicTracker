<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- MAIN SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#8E24AA"
            android:title="Dashboard"
            android:titleTextColor="@android:color/white"/>

        <!-- CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- DATE -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: 26 Dec 2025"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <!-- MARK ATTENDANCE BUTTON -->
                <Button
                    android:id="@+id/btnMarkAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mark Attendance"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#8E24AA"
                    android:textColor="@android:color/white"/>

                <!-- MONTHLY STATS TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month Attendance"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <!-- STATS -->
                <TextView
                    android:id="@+id/tvMonthlyStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Present: 18 days\nAbsent: 4 days"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"/>

                <!-- PREVIOUS MONTH BUTTON -->
                <Button
                    android:id="@+id/btnPreviousMonths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Previous Months"
                    android:layout_marginTop="24dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SIDE MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#E1BEE7"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"/>

</androidx.drawerlayout.widget.DrawerLayout>
